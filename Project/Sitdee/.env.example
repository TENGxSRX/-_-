# Copy to .env locally only. Do not commit the copy.
# All values below are fake placeholders; replace only on the private machine.

# Option A: provide a complete RTSP URL locally.
POSTURE_RTSP_URL=rtsp://YOUR_USER:YOUR_PASSWORD@CAMERA_HOST:554/Streaming/Channels/101

# Option B: let the project build a Hikvision profile URL.
POSTURE_CAMERA_HOST=CAMERA_HOST_OR_IP
POSTURE_CAMERA_PORT=554
POSTURE_CAMERA_USER=YOUR_USER
POSTURE_CAMERA_PASSWORD=YOUR_PASSWORD
POSTURE_HIKVISION_PROFILE=HIKVISION_MAIN
POSTURE_CAMERA_ID=CAM01

# Optional local stream-path/scheme overrides.
# POSTURE_CAMERA_STREAM_PATH=/Streaming/Channels/101
# POSTURE_RTSP_SCHEME=rtsp

# Optional Roboflow integration. Keep real values in .env only.
ROBOFLOW_API_KEY=YOUR_PRIVATE_API_KEY
ROBOFLOW_MODEL_ID=YOUR_PROJECT_SLUG/YOUR_VERSION
ROBOFLOW_API_URL=https://serverless.roboflow.com
